# ==============================================================================
# CreatorCoach AI Environment Variables
# Copy this file to .env.local to configure your local or hosted instances
# ==============================================================================

# Supabase Configuration
# Required for production authentication, session cookies, and PostgreSQL persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Ollama Open-Source AI Configuration
# Default local Ollama host is http://127.0.0.1:11434
# For hosted cloud GPU runners (e.g., RunPod, Modal, Vultr, Ollama remote), provide the secured URL
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=30000

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
